APP_NAME=Bank Async API
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://bank_user:bank_pass@db:5432/bank_db
DATABASE_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=30

JWT_SECRET_KEY=troque_esta_chave_em_producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

OPERATION_TIMEOUT_SECONDS=30

NOTIFICATION_WEBHOOK_URL=

SEED_ON_STARTUP=true
SEED_CLIENTES=20
SEED_CONTAS=20
SEED_TRANSACOES=100

LOG_DIR=logs

FASTAPI_BASE_URL=http://api:8000
FLASK_SECRET_KEY=troque_esta_chave_flask
